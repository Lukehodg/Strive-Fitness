{
  "expo": {
    "name": "Stride",
    "slug": "strive",
    "scheme": "strive",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#17140F"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lukehodg.strive",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Stride uses your location to find activities near you.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.lukehodg.strive",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF9F1C"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Stride uses your location to find activities near you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Stride needs photo access so you can set a profile picture."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "supabaseUrl": "https://srpurixecxfuzyfoajmx.supabase.co",
      "supabaseAnonKey": "sb_publishable_C1XeZqy8BTKFGlUxPEuboA_Rn8NPk6n",
      "streamApiKey": "",
      "googleWebClientId": "",
      "googleIosClientId": "",
      "eas": {
        "projectId": "6ddf8985-6305-4075-95e4-2be1240d41ce"
      },
      "router": {
        "origin": false
      }
    },
    "owner": "lukehodg"
  }
}
