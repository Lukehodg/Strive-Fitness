# Auto-Trader configuration.
#
# The platform runs fully without any of these — it falls back to synthetic
# market data and a simulated paper broker. Set these when you want real FX
# prices and/or live trading.
#
# ---------------------------------------------------------------------------
# OANDA — the only broker. This platform trades spot FX and nothing else.
#
# Get a v20 personal access token from the OANDA web dashboard:
#   Manage API Access -> Generate. It is shown ONCE; store it somewhere safe.
#
# The account id is the four-part number in the same dashboard, e.g.
# 001-004-1234567-001. It is NOT your login or your account nickname.
# ---------------------------------------------------------------------------
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=

# PRACTICE by default, deliberately. Getting this the wrong way round is the
# one configuration mistake here that costs real money, so you have to opt in
# to the live host explicitly. A practice token does not work against the live
# host, or vice versa — the token and the URL must match the account type.
#   Practice: https://api-fxpractice.oanda.com
#   Live:     https://api-fxtrade.oanda.com
OANDA_BASE_URL=https://api-fxpractice.oanda.com

# Refuse to start on simulated prices rather than silently falling back.
# Worth setting once you have credentials working — a .env that stops being
# read looks exactly like a calm market.
# REQUIRE_REAL_DATA=1

# Optional: enables the AI analyst in the self-improvement engine ("AI Lab").
# Without it, the platform still self-improves via the deterministic
# walk-forward optimizer — the Claude analyst just adds code/trade review.
ANTHROPIC_API_KEY=

# Optional: push alerts (fills, kill-switch trips, engine stalls) to your
# phone via a Telegram bot. Create a bot with @BotFather to get the token;
# message your bot once, then GET /getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
