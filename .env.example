# Optional in development. Required in production. Use a NEW empty database initially.
# DATABASE_URL=postgresql://user:password@localhost:5432/strive
# LOCAL_DATABASE_PATH=./.data/strive
HOST=127.0.0.1
PORT=5000
# Private beta: comma-separated email addresses allowed to create NEW accounts.
# BETA_ALLOWED_EMAILS=
# Only behind exactly one trusted reverse proxy:
# TRUST_PROXY=1

# Optional existing food search integration:
# NUTRITIONIX_APP_ID=
# NUTRITIONIX_API_KEY=

# Wearables: server-only values. See WEARABLE_SETUP.md.
# The public HTTPS origin, without a path, must match provider registrations.
# PUBLIC_API_URL=https://api.your-domain.example
# Generate a 32-byte random hex key; keep it stable and backed up separately.
# INTEGRATION_ENCRYPTION_KEY=
# WHOOP_CLIENT_ID=
# WHOOP_CLIENT_SECRET=
# OURA_CLIENT_ID=
# OURA_CLIENT_SECRET=
# Email import/sending credentials are not consumed yet.

# Mail integrations (server only; never put these secrets in Expo variables)
MAIL_GMAIL_CLIENT_ID=
MAIL_GMAIL_CLIENT_SECRET=
MAIL_OUTLOOK_CLIENT_ID=
MAIL_OUTLOOK_CLIENT_SECRET=
