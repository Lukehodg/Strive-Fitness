# Copy to .env and fill in. Never commit the real .env (it's gitignored).
# These are read in app.config.ts and exposed via Constants.expoConfig.extra.
#
# NOTE: for EAS cloud builds, the Supabase URL + publishable key are baked into
# app.json `extra` (they're public client values). This .env is only needed for
# local `npm start` development.

# Supabase (Project Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Google OAuth client IDs (Google Cloud Console -> Credentials)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Strava OAuth — Client ID only (public). https://www.strava.com/settings/api
EXPO_PUBLIC_STRAVA_CLIENT_ID=

# Sentry crash reporting — DSN (public). Leave blank to disable.
EXPO_PUBLIC_SENTRY_DSN=

# ---------------------------------------------------------------------------
# SERVER-SIDE ONLY — set these as Supabase Edge Function secrets, NOT here.
# Listed for reference. The app must never see these.
#   STRAVA_CLIENT_ID / STRAVA_CLIENT_SECRET  # supabase secrets set STRAVA_CLIENT_ID=... STRAVA_CLIENT_SECRET=...
#   SUPABASE_SERVICE_ROLE_KEY...             # provided to Edge Functions automatically
