{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "tsx server/index.ts",
    "train": "tsx server/ml/train.ts",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "check:execution": "tsx server/trading/executionChecks.ts",
    "screen": "python screener/screen.py",
    "check:portfolio": "tsx server/trading/portfolioChecks.ts",
    "calibrate": "tsx server/calibrate.ts",
    "sweep:margin": "tsx server/trading/marginEvalFast.ts",
    "facts": "tsx server/trading/factsCheck.ts",
    "check:oanda": "tsx server/trading/oandaCheck.ts",
    "positioning": "tsx server/trading/positioningReport.ts",
    "kronos:sidecar": "python kronos_sidecar/server.py",
    "kronos:sidecar:stub": "cross-env KRONOS_STUB=1 python kronos_sidecar/server.py",
    "eval:forex": "tsx server/trading/forexEval.ts",
    "test": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.114.0",
    "@jridgewell/trace-mapping": "^0.3.25",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "@tanstack/react-query": "^5.60.5",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.0",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "wouter": "^3.3.5",
    "ws": "^8.18.0",
    "zod": "^3.23.8",
    "zod-validation-error": "^3.4.0"
  },
  "devDependencies": {
    "@replit/vite-plugin-cartographer": "^0.0.11",
    "@replit/vite-plugin-runtime-error-modal": "^0.0.3",
    "@tailwindcss/typography": "^0.5.15",
    "@types/express": "4.17.21",
    "@types/node": "20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "esbuild": "^0.25.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.1",
    "typescript": "5.6.3",
    "vite": "^5.4.14"
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.8"
  }
}