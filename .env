EXPO_PUBLIC_SUPABASE_URL=https://srpurixecxfuzyfoajmx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_C1XeZqy8BTKFGlUxPEuboA_Rn8NPk6n


# Stream Chat (Dashboard -> App -> API key; public key only)
